{
  "name": "triskel-video-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Serviço assíncrono de análise de vídeo UGC (ffprobe/ffmpeg + LLM opcional com fallback determinístico)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": { "node": ">=22.5" },
  "dependencies": {
    "dotenv": "^18.0.9",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}

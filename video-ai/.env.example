# video-ai · análise assíncrona de vídeo
PORT=4300
# Chave que o back usa para criar jobs (Authorization: Bearer)
VIDEOAI_API_KEY=videoai_dev_key_troque
# Segredo para assinar o webhook de resultado (igual ao VIDEOAI_WEBHOOK_SECRET do back)
WEBHOOK_SECRET=troque-por-um-segredo-de-32-caracteres-ou-mais
# Proteção contra SSRF: só baixa vídeo e só chama callback nestes hosts (host:porta, separados por vírgula)
ALLOWED_FETCH_HOSTS=localhost:4000,127.0.0.1:4000,back:4000
ALLOWED_CALLBACK_HOSTS=localhost:4000,127.0.0.1:4000,back:4000
MAX_VIDEO_MB=200
DOWNLOAD_TIMEOUT_MS=120000
JOB_CONCURRENCY=1
DB_PATH=./data/video-ai.db
# LLM opcional. Sem chave, a análise é determinística (só requisitos técnicos medidos com ffprobe/ffmpeg).
# ATENÇÃO: com a chave, alguns quadros do vídeo são enviados à API da Anthropic.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

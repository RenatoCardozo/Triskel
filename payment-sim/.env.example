# payment-sim · gateway SIMULADO. Valores abaixo são de desenvolvimento; troque em qualquer ambiente compartilhado.
PORT=4100
# Chave secreta que o back usa (Authorization: Bearer ...)
PAYSIM_API_KEY=sk_test_troque_esta_chave
# Chave pública (somente tokenização de cartão, chamada do navegador)
PAYSIM_PUBLIC_KEY=pk_test_troque_esta_chave
# Chave do painel/administração
PAYSIM_ADMIN_KEY=adm_test_troque_esta_chave
# Para onde enviar os webhooks e com qual segredo assinar (precisa ser igual ao PAYMENT_WEBHOOK_SECRET do back)
WEBHOOK_URL=http://localhost:4000/webhooks/payments
WEBHOOK_SECRET=troque-por-um-segredo-de-32-caracteres-ou-mais
# Origens autorizadas a tokenizar cartão pelo navegador
CORS_ORIGINS=http://localhost:3000
# Arquivo do banco SQLite (próprio do payment-sim)
DB_PATH=./data/payment-sim.db
# Validade do Pix (segundos) e pagamento automático opcional (0 = só pelo painel)
PIX_TTL_SECONDS=600
PIX_AUTOPAY_SECONDS=0
# Saque: conclui sozinho após N ms (PAYOUT_AUTO=false deixa para o painel decidir)
PAYOUT_AUTO=true
PAYOUT_DELAY_MS=1500
PIX_KEY=pagamentos@triskel.simulado

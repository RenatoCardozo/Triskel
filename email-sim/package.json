{
  "name": "triskel-email-sim",
  "version": "1.0.0",
  "private": true,
  "description": "Servidor SMTP de captura + caixa de entrada web + API REST (nenhum e-mail sai de verdade)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-ui.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": { "node": ">=22.5" },
  "dependencies": {
    "dotenv": "^18.0.9",
    "fastify": "^5.12.8",
    "@fastify/helmet": "^13.2.0",
    "mailparser": "^3.9.8",
    "smtp-server": "^3.18.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/smtp-server": "^3.5.12",
    "nodemailer": "^10.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}

# email-sim · captura de e-mails (nada sai para a internet)
SMTP_PORT=2525
WEB_PORT=4200
# Opcional: exige X-Api-Key na API REST e na UI. Vazio = aberto (ambiente local).
EMAILSIM_API_KEY=
DB_PATH=./data/email-sim.db
MAX_MESSAGE_MB=15
# Quantas mensagens manter (as mais antigas são apagadas)
KEEP_MESSAGES=500

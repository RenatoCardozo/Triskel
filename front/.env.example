# front · Next.js. Copie para .env.local. NUNCA commite segredos.
# URL do back visto PELO SERVIDOR do front (BFF). No docker-compose: http://back:4000
BACK_URL=http://localhost:4000

# Origens que podem chamar o BFF com métodos que alteram dados (defesa contra CSRF), separadas por vírgula.
# O host da própria requisição já é aceito; use isto quando houver proxy reverso com outro domínio.
APP_ORIGINS=http://localhost:3000

# Cookies de sessão com flag Secure. Em produção (HTTPS) deixe true. Em http://localhost use false.
COOKIE_SECURE=false

# payment-sim: o navegador tokeniza o cartão direto no gateway com a chave PÚBLICA (nunca a secreta).
# A chave pública é valor de teste e pode ser exposta ao navegador por definição. Precisa ser igual a PAYSIM_PUBLIC_KEY do payment-sim.
NEXT_PUBLIC_PAYSIM_URL=http://localhost:4100
NEXT_PUBLIC_PAYSIM_PK=pk_test_troque_esta_chave

# email-sim (caixa de entrada de demonstração): usado só no link "Abrir meu e-mail" da tela de validação.
NEXT_PUBLIC_EMAILSIM_URL=http://localhost:4200

# Atenção: NEXT_PUBLIC_* é embutido no bundle em build time (no Docker, passe como build args).

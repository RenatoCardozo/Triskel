# Triskel · variáveis do docker-compose.yml. Copie para .env (ou rode ./scripts/gen-env.sh) e NUNCA commite o .env.
# Os valores abaixo são marcadores. Gere segredos aleatórios com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Em produção (NODE_ENV=production) o back recusa valores contendo "troque".

MYSQL_PASSWORD=troque-esta-senha
MYSQL_ROOT_PASSWORD=troque-esta-senha-root

JWT_ACCESS_SECRET=troque-este-segredo-de-pelo-menos-32-caracteres-aleatorios
CODE_PEPPER=troque-esta-pimenta-16+
FILE_TOKEN_SECRET=troque-este-segredo-de-arquivo-16+

# payment-sim: chave secreta (só o back), chave pública (vai ao navegador), chave de administração (painel/autopay) e segredo do webhook
PAYSIM_API_KEY=sk_test_troque_esta_chave
PAYSIM_PUBLIC_KEY=pk_test_troque_esta_chave
PAYSIM_ADMIN_KEY=adm_test_troque_esta_chave
PAYMENT_WEBHOOK_SECRET=troque-por-um-segredo-de-32-caracteres-ou-mais

# video-ai
VIDEOAI_API_KEY=troque-esta-chave-do-video-ai
VIDEOAI_WEBHOOK_SECRET=troque-por-um-segredo-de-32-caracteres-ou-mais
# Opcional: habilita a análise por LLM (sem ela, vale o analisador local)
ANTHROPIC_API_KEY=

# Demonstração: true popula o banco VAZIO com os dados do protótipo (senha dos usuários de exemplo: SEED_PASSWORD, ou a padrão do seed)
SEED_ON_START=false
SEED_PASSWORD=

# true quando o front for servido por HTTPS
COOKIE_SECURE=false

# back · API da Triskel. Copie para .env e ajuste. NUNCA commite o .env.
# Todos os valores abaixo são de DESENVOLVIMENTO. Segredos reais vêm do ambiente (ou do gerenciador de segredos), nunca do repositório.
# Gere segredos com:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# MySQL (o docker-compose da raiz sobe um). Para o Prisma e para a aplicação.
DATABASE_URL=mysql://triskel:triskel@127.0.0.1:3306/triskel

# URLs: do próprio back (links em e-mails e arquivos), do front, e do back visto pelo video-ai (rede interna)
PUBLIC_API_URL=http://localhost:4000
PUBLIC_WEB_URL=http://localhost:3000
INTERNAL_API_URL=http://localhost:4000
# Origens autorizadas no CORS (separe por vírgula)
CORS_ORIGINS=http://localhost:3000

# Sessão: JWT de acesso curto + refresh token rotativo (guardado só como hash no banco)
JWT_ACCESS_SECRET=troque-este-segredo-de-pelo-menos-32-caracteres-aleatorios
ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=1209600
BCRYPT_COST=12
# Pimenta do hash dos códigos de verificação de e-mail e segredo das URLs assinadas de arquivo
CODE_PEPPER=troque-esta-pimenta-16+
FILE_TOKEN_SECRET=troque-este-segredo-de-arquivo-16+

# Limites de requisição por IP/minuto
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# Arquivos enviados (fotos e vídeos). Local por padrão; a interface Storage permite trocar por S3.
STORAGE_DIR=./uploads
MAX_VIDEO_MB=100
MAX_IMAGE_MB=5

# E-mail: SMTP do email-sim (captura tudo, não envia para fora)
MAIL_ENABLED=true
SMTP_HOST=localhost
SMTP_PORT=2525
SMTP_SECURE=false
MAIL_FROM="Triskel <nao-responda@triskel.com.br>"

# payment-sim (gateway simulado): chave secreta do back e segredo do webhook (igual ao WEBHOOK_SECRET do payment-sim)
PAYMENT_API_URL=http://localhost:4100
PAYMENT_API_KEY=sk_test_troque_esta_chave
PAYMENT_WEBHOOK_SECRET=troque-por-um-segredo-de-32-caracteres-ou-mais

# video-ai (análise de vídeo): chave do back e segredo do webhook (igual ao WEBHOOK_SECRET do video-ai)
VIDEOAI_API_URL=http://localhost:4300
VIDEOAI_API_KEY=videoai_dev_key_troque
VIDEOAI_WEBHOOK_SECRET=troque-por-um-segredo-de-32-caracteres-ou-mais

# Confirmação de publicação (verificador simulado): espera antes de confirmar
PUBLICATION_CHECK_DELAY_MS=3000
JOBS_ENABLED=true

# Seed de demonstração (opcional): senha de todos os usuários de exemplo
# SEED_PASSWORD=Triskel@2026

# Hospedagem (Render + banco gerenciado): veja ../docs/DEPLOY.md
# DATABASE_SSL=true liga TLS no banco (Aiven e similares exigem). Com DATABASE_CA_CERT (PEM da CA) o certificado é verificado.
# DATABASE_SSL=false
# DATABASE_CA_CERT=
# MAIL_TRANSPORT=http envia o e-mail por HTTP ao email-sim (quando não há SMTP entre os serviços)
# MAIL_TRANSPORT=smtp
# MAIL_HTTP_URL=http://localhost:4200
# MAIL_HTTP_KEY=
